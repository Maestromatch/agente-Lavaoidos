# ── Anthropic (Claude) ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# ── WhatsApp Business (Meta Cloud API) ─────────────────────────
WHATSAPP_PHONE_ID=000000000000000
WHATSAPP_TOKEN=EAAxxxxx
WHATSAPP_VERIFY_TOKEN=string_secreto_que_tu_eliges
# Número del administrador que recibe notificaciones (sin + ni espacios)
ADMIN_PHONE=56900000000

# ── Mercadopago ────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxx

# ── Google Sheets (Service Account) ────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxx@xxxx.iam.gserviceaccount.com
# La private key debe ir entre comillas y con \n literales (no saltos reales)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App ────────────────────────────────────────────────────────
APP_URL=https://agente-lavaoidos.vercel.app
NODE_ENV=production

# ── Cron secret (string aleatorio, configurar también en Vercel) ──
CRON_SECRET=cambia_esto_por_string_random_largo

# ── Meta Lead Ads (firma del webhook) ──────────────────────────
# App secret de la app de Meta. Para validar firmas HMAC del webhook.
LEAD_ADS_APP_SECRET=

# ── Templates WhatsApp ─────────────────────────────────────────
# Código del idioma usado al subir las plantillas a aprobación (es, es_CL, es_MX, etc.)
WHATSAPP_TEMPLATE_LANG=es
